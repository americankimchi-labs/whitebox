<?xml version="1.0" encoding="utf-8"?>
<!-- TLS everywhere, with one exception: 10.0.2.2 is the Android emulator's alias for its host computer, where a
     developer or judge runs the local mirror (`./gradlew :server:run`). Nothing else may be reached without TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
