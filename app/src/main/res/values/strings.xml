    <!-- First run -->
    <string name="intro_title">White Box는 운전자의 조작을 기록합니다</string>
    <string name="intro_what_title">무엇을 기록하나요</string>
    <string name="intro_what">브레이크, 방향지시등, 조향각, 기어, 속도, 위치. 영상과 음성은 기록하지 않습니다.</string>
    <string name="intro_where_title">어디에 보관되나요</string>
    <string name="intro_where">기록 원본은 이 차량 안에 저장되며, 해시 체인과 기기 서명으로 위·변조를 막습니다.</string>
    <string name="intro_whose_title">누구의 기록인가요</string>
    <string name="intro_whose">운전자 본인의 증거입니다. 제조사나 보험사로 자동 전송되지 않으며, 공유 여부는 운전자가 정합니다.</string>
    <string name="intro_start">시작하기</string>
    <string name="setup_parked_only">설정은 주차(P) 상태에서만 진행할 수 있습니다.</string>
    <string name="step_count">%1$d / %2$d</string>
    <string name="step_speed_title">차량 속도</string>
    <string name="step_speed_body">급제동과 충격을 감지하려면 차량 속도가 필요합니다.</string>
    <string name="step_location_title">위치</string>
    <string name="step_location_body">사건 장소와 블랙박스 영상과의 시간 맞춤(GPS 시각)에 사용합니다.</string>
    <string name="step_background_title">위치 \'항상 허용\'</string>
    <string name="step_background_body">앱을 열지 않아도 시동과 함께 기록이 시작되려면 필요합니다. 다음 화면에서 \'항상 허용\'을 선택해 주세요.</string>
    <string name="step_notifications_title">알림</string>
    <string name="step_notifications_body">기록 중임을 알림 영역에 표시합니다.</string>
    <string name="step_allow">허용</string>
