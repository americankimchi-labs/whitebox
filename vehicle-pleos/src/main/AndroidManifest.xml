<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exactly what the typed calls need. Never CONTROL_* or PRIVATE_*. -->
    <!-- Brake, steering angle, cruise control, odometer -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Turn signal, low/high beam, tail lamps -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- Airbag deployed -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- Door positions -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- Seat belts, seat occupancy -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Wiper state, window positions -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- EV instantaneous efficiency -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />

    <!-- AAOS speed: dangerous, granted at runtime during first-run setup while parked. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- AAOS gear (GEAR_SELECTION), ignition state, parking brake (PARKING_BRAKE_ON) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- Pleos speech: the keep question, post-crash guidance, the offline voice bookmark -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application>
        <!-- Gleo Interface: only the car assistant (holder of its signature permission) can send our function. -->
        <receiver
            android:name="com.americankimchilabs.whitebox.vehicle.pleos.GleoActionReceiver"
            android:exported="true"
            android:permission="ai.umos.gleo.permission.APP_ACTION">
            <intent-filter>
                <action android:name="BOOKMARK_MOMENT" />
                <!-- What the car assistant actually sends (package-qualified, unlike the interface guide's example). -->
                <action android:name="com.americankimchilabs.whitebox.BOOKMARK_MOMENT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
